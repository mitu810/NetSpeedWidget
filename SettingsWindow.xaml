<Window
    x:Class="NetSpeedWidget.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Grid
        x:Name="SettingsRoot"
        Background="#202020">
        <Grid.Resources>
            <SolidColorBrush x:Key="SettingRowBackgroundBrush" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="SettingRowBorderBrush" Color="#3A3A3A"/>

            <Style x:Key="SettingRowBorderStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="58"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="{StaticResource SettingRowBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SettingRowBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,4,0,2"/>
                <Setter Property="Foreground" Value="#CFCFCF"/>
            </Style>

            <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style x:Key="SettingsNavigationTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarHost"
            Grid.Row="0"
            MinHeight="38"
            Padding="12,0,138,0"
            Background="#202020">
            <TextBlock
                x:Name="TitleBarText"
                Text="Settings"
                FontSize="12"
                Foreground="#FFFFFF"
                VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="SettingsNavigationColumn"
                    Width="174"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SettingsNavigationRail"
                Grid.Column="0"
                Padding="8,14,8,0"
                Background="#202020">
                <StackPanel Spacing="2">
                    <Button
                        x:Name="NetSpeedNavigationButton"
                        Style="{StaticResource SettingsNavigationButtonStyle}"
                        AutomationProperties.Name="网速显示"
                        Click="NetSpeedNavigationButton_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="NetSpeedNavigationSelectionBar"
                                Width="3"
                                Height="18"
                                CornerRadius="2"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <SymbolIcon
                                x:Name="NetSpeedNavigationIcon"
                                Grid.Column="1"
                                Symbol="Sync"
                                Foreground="#FFFFFF"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="NetSpeedNavigationText"
                                Grid.Column="2"
                                Text="网速显示"
                                Style="{StaticResource SettingsNavigationTextStyle}"/>
                        </Grid>
                    </Button>

                    <Button
                        x:Name="SystemStatusNavigationButton"
                        Style="{StaticResource SettingsNavigationButtonStyle}"
                        AutomationProperties.Name="系统状态"
                        Click="SystemStatusNavigationButton_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="SystemStatusNavigationSelectionBar"
                                Width="3"
                                Height="18"
                                CornerRadius="2"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <SymbolIcon
                                x:Name="SystemStatusNavigationIcon"
                                Grid.Column="1"
                                Symbol="ViewAll"
                                Foreground="#FFFFFF"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="SystemStatusNavigationText"
                                Grid.Column="2"
                                Text="系统状态"
                                Style="{StaticResource SettingsNavigationTextStyle}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Grid
                x:Name="SettingsPageHost"
                Grid.Column="1">
                <ScrollViewer
                    x:Name="NetSpeedSettingsPanel"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel
                        Padding="20"
                        Spacing="14">
                        <TextBlock
                            x:Name="TitleText"
                            Text="设置"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"/>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="AppearanceSectionTitle"
                                Text="外观"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SpeedFontSizeLabel"
                                        Text="字体大小"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <TextBox
                                            x:Name="SpeedFontSizeTextBox"
                                            Width="86"
                                            MaxLength="2"
                                            HorizontalContentAlignment="Right"
                                            LostFocus="SpeedFontSizeTextBox_LostFocus"
                                            KeyDown="SpeedFontSizeTextBox_KeyDown"/>

                                        <TextBlock
                                            x:Name="SpeedFontSizeUnitLabel"
                                            Text="px"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="ThemeLabel"
                                        Text="背景主题"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                        <RadioButton
                                            x:Name="DarkThemeRadio"
                                            Content="深色"
                                            Foreground="#FFFFFF"
                                            GroupName="Theme"/>

                                        <RadioButton
                                            x:Name="LightThemeRadio"
                                            Content="浅色"
                                            Foreground="#FFFFFF"
                                            GroupName="Theme"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="WindowSectionTitle"
                                Text="窗口"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="StartupLabel" Text="开机启动" Style="{StaticResource SettingLabelStyle}"/>
                                        <TextBlock x:Name="StartupStateText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="StartupToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="TopmostLabel"
                                        Text="始终置顶"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="TopmostToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="LockWindowLabel"
                                        Text="固定窗口"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="LockWindowToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="DisplayModeLabel"
                                        Text="显示位置"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ComboBox
                                        x:Name="DisplayModeCombo"
                                        Grid.Column="1"
                                        Width="158"
                                        HorizontalAlignment="Right">
                                        <ComboBoxItem Content="桌面悬浮"/>
                                        <ComboBoxItem Content="任务栏左侧"/>
                                        <ComboBoxItem Content="任务栏右侧"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="TaskbarEdgePaddingLabel"
                                        Text="任务栏边距"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <TextBox
                                            x:Name="TaskbarEdgePaddingTextBox"
                                            Width="86"
                                            MaxLength="3"
                                            HorizontalContentAlignment="Right"
                                            LostFocus="TaskbarEdgePaddingTextBox_LostFocus"
                                            KeyDown="TaskbarEdgePaddingTextBox_KeyDown"/>

                                        <TextBlock
                                            x:Name="TaskbarEdgePaddingUnitLabel"
                                            Text="px"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SystemStatusSettingsPanel"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel
                        Padding="20"
                        Spacing="14">
                        <TextBlock
                            x:Name="SystemStatusTitleText"
                            Text="系统状态"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"/>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="SystemStatusServiceSectionTitle"
                                Text="局域网服务"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusEnabledLabel"
                                        Text="启用系统状态"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="SystemStatusEnabledToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="硬件温度采集" Style="{StaticResource SettingLabelStyle}"/>
                                        <Button x:Name="HardwareAuthorizeButton" Grid.Column="1" Content="授权硬件采集" Click="HardwareAuthorizeButton_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="HardwareStateText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                               Text="首次授权需要管理员确认；未授权不影响网速。"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusServerLabel"
                                        Text="自动启动服务"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="SystemStatusServerToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusPortLabel"
                                        Text="首选端口"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <TextBox
                                        x:Name="SystemStatusPortTextBox"
                                        Grid.Column="1"
                                        Width="100"
                                        MaxLength="5"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusServiceStatusLabel"
                                        Text="服务状态"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <TextBlock
                                        x:Name="SystemStatusServiceStatusText"
                                        Grid.Column="1"
                                        MinWidth="120"
                                        Text="未启动"
                                        TextAlignment="Right"
                                        Style="{StaticResource SettingLabelStyle}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusAccessAddressLabel"
                                        Text="访问地址"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <TextBlock
                                        x:Name="SystemStatusAccessAddressText"
                                        Grid.Column="1"
                                        Width="280"
                                        Text="未启动"
                                        TextAlignment="Right"
                                        TextWrapping="WrapWholeWords"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        Foreground="#FFFFFF"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusServiceErrorLabel"
                                        Text="服务错误"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <TextBlock
                                        x:Name="SystemStatusServiceErrorText"
                                        Grid.Column="1"
                                        Width="280"
                                        Text="无"
                                        TextAlignment="Right"
                                        TextWrapping="WrapWholeWords"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        Foreground="#FFFFFF"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusRefreshIntervalLabel"
                                        Text="刷新间隔"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ComboBox
                                        x:Name="SystemStatusRefreshIntervalCombo"
                                        Grid.Column="1"
                                        Width="130"
                                        HorizontalAlignment="Right">
                                        <ComboBoxItem Content="1 秒"/>
                                        <ComboBoxItem Content="2 秒"/>
                                        <ComboBoxItem Content="3 秒"/>
                                        <ComboBoxItem Content="5 秒"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusPasswordLabel"
                                        Text="启用访问密码"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="SystemStatusPasswordToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusPasswordValueLabel"
                                        Text="访问密码"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <PasswordBox
                                        x:Name="SystemStatusPasswordBox"
                                        Grid.Column="1"
                                        Width="180"
                                        PlaceholderText="输入新密码"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SystemStatusWebThemeLabel"
                                        Text="网页主题"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ComboBox
                                        x:Name="SystemStatusWebThemeCombo"
                                        Grid.Column="1"
                                        Width="130"
                                        HorizontalAlignment="Right">
                                        <ComboBoxItem Content="跟随软件"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="SystemStatusCardsSectionTitle"
                                Text="页面卡片"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="NetworkStatusCardLabel"
                                        Text="网速卡片"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="NetworkStatusCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="CpuUsageCardLabel"
                                        Text="CPU 占用率"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="CpuUsageCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="CpuTemperatureCardLabel"
                                        Text="CPU 温度"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="CpuTemperatureCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="GpuUsageCardLabel"
                                        Text="GPU 占用率"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="GpuUsageCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="GpuTemperatureCardLabel"
                                        Text="GPU 温度"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="GpuTemperatureCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowBorderStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="MemoryUsageCardLabel"
                                        Text="内存占用率"
                                        Style="{StaticResource SettingLabelStyle}"/>

                                    <ToggleSwitch
                                        x:Name="MemoryUsageCardToggle"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
