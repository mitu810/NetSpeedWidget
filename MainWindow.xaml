<Window
    x:Class="NetSpeedWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetSpeedWidget">

    <Grid
        x:Name="RootBackground"
        Background="#202020">
        <Border
            x:Name="RootGrid"
            Padding="2"
            CornerRadius="20"
            Background="#202020">

            <StackPanel
                x:Name="ContentPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4">

                <TextBlock
                    x:Name="UploadText"
                    Text="&#x2191; 0 B/s"
                    FontFamily="Tahoma"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Center"
                    TextWrapping="NoWrap"/>

                <TextBlock
                    x:Name="DownloadText"
                    Text="&#x2193; 0 B/s"
                    FontFamily="Tahoma"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Center"
                    TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
